#!/usr/bin/env bash
# Blocks a commit if gitleaks finds a secret in the staged changes.
# Enabled repo-wide via `git config core.hooksPath .githooks` (run once
# after cloning — see .githooks/README.md).

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v --source "$repo_root"
  exit $?
fi

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  # MSYS_NO_PATHCONV keeps Git Bash on Windows from mangling the -v mount path.
  MSYS_NO_PATHCONV=1 docker run --rm \
    -v "${repo_root}:/repo" \
    zricethezav/gitleaks:latest \
    protect --staged --redact -v --source /repo
  exit $?
fi

echo "warning: gitleaks not found and Docker isn't running — skipping the secret scan for this commit." >&2
echo "         install gitleaks (https://github.com/gitleaks/gitleaks#installing) or start Docker to re-enable it." >&2
exit 0
